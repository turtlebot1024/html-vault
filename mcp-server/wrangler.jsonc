{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-vault-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HtmlVaultMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "HtmlVaultMCP"
      }
    ]
  },
  "vars": {
    "VAULT_REPO": "turtlebot1024/html-vault-data",
    "VAULT_PATH": "cards.json",
    "VAULT_BRANCH": "main",
    "VAULT_READONLY": "false"
  },
  "observability": {
    "enabled": true
  }
}
